# ===== 应用配置 =====
# 运行模式：dev（开发，挂载 Vite 代理目标） / prod（挂载 frontend/dist 静态资源）
APP_ENV=dev

# ===== 端口 =====
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ===== 数据库 =====
# 相对 backend/ 工作目录
DB_PATH=data/data.db

# ===== 日志 =====
LOG_DIR=logs
LOG_LEVEL=INFO

# ===== 数据源（akshare）=====
# 数据源请求间隔（秒），防 IP 封禁
DATA_SOURCE_INTERVAL=1.5
# 首次拉取的历史年限
HISTORY_YEARS=3
# ETF 行情源：sina（新浪）/ em（东方财富），新浪在本环境可用，东方财富可能被远端重置
ETF_DATA_SOURCE=sina

# ===== 计算参数 =====
# MA 均线周期，逗号分隔
MA_PERIODS=5,10,20,30,60
